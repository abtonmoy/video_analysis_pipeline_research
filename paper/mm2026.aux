\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces ISD Threshold Sensitivity. Mean ISD across variance thresholds ($\tau $). $\tau =0.90$ (marked) provides optimal balance between coverage (23.4 frames) and efficiency.}}{10}{figure.caption.17}\protected@file@percent }
